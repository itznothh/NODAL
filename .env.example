# Copy to .env for local development. Never commit real secrets.
MONGO_URI=mongodb://localhost:27017
NODAL_ENV=development
NODAL_SECRET_KEY=replace-with-a-random-secret-before-use
NODAL_DB_NAME=nodal_dev
NODAL_AUDIT_MODE=false
NODAL_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Private image-evidence directory; defaults to the operating-system user's local application data outside the repository.
# NODAL_EVIDENCE_DIR=C:/var/lib/nodal/evidence
# Production requires explicit non-placeholder values for NODAL_DB_NAME,
# MONGO_URI, NODAL_SECRET_KEY (at least 32 characters), and trusted HTTPS
# NODAL_CORS_ORIGINS. See docs/DEPLOYMENT.md.

# One-time bootstrap only. Set these with NODAL_DB_NAME in the shell, then run
# `python -m backend.bootstrap_admin --database <same-name>` and remove the
# credentials immediately after creation. The CLI requires typed confirmation.
# NODAL_BOOTSTRAP_ADMIN_EMAIL=admin@example.org
# NODAL_BOOTSTRAP_ADMIN_PASSWORD=use-a-unique-password-of-at-least-12-characters
# NODAL_BOOTSTRAP_ADMIN_NAME=Platform Administrator
